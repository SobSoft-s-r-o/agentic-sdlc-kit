#!/bin/sh
# agentic-sdlc-kit git hook: post-checkout. Managed by `sdlc init` and `sdlc upgrade`; local edits are overwritten.
# The logic is `sdlc githook post-checkout`; this script only finds the sdlc command and hands over.
if command -v sdlc >/dev/null 2>&1; then
  exec sdlc githook post-checkout "$@"
fi
# --no-install: a hook must never download a package, and npx would ask before doing so.
if command -v npx >/dev/null 2>&1 && npx --no-install sdlc --version >/dev/null 2>&1; then
  exec npx --no-install sdlc githook post-checkout "$@"
fi
echo "sdlc not found; agentic-sdlc-kit git hook post-checkout skipped (install: see INSTALL.md)" >&2
exit 0
